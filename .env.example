# .env.example — variable NAMES only. Never commit real values.
# This app intentionally has NO browser-side Supabase client, so NO NEXT_PUBLIC_* variables are used.
# Never prefix a secret with NEXT_PUBLIC_.

# ======================= VERCEL (Next.js app; server-side only) =======================
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SECRET (mark as Sensitive in Vercel). Used only in server code after server-side admin verification.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed site, e.g. https://your-domain.com (used for auth redirects)
APP_ORIGIN=

# SECRET (Sensitive). At least 32 random chars: `openssl rand -hex 32`. HMAC salt for hashing IPs in the audit log.
AUDIT_IP_HASH_SALT=

# R2 (primary private storage for video + thumbnails). Credentials are SECRET (mark Sensitive in
# Vercel) — used only server-side to presign URLs; never sent to the browser. Scope this key to the
# one bucket only (Cloudflare dashboard → R2 → Manage API Tokens → scope to bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: rate limiting (src/lib/rate-limit.ts). Without these, rate limiting fails OPEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ======================= RAILWAY (private worker) =======================
# Direct Postgres connection as the dedicated `video_worker` role (NOT the service-role key). Set the
# role's password manually first — see docs/setup.md. Never commit the resulting connection string.
WORKER_DATABASE_URL=
WORKER_R2_ACCOUNT_ID=
WORKER_R2_ACCESS_KEY_ID=
WORKER_R2_SECRET_ACCESS_KEY=
WORKER_R2_BUCKET=
B2_S3_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BACKUP_BUCKET=
B2_AUDIT_EXPORT_PREFIX=audit-exports/
B2_RETENTION_DAYS=
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LOCK_SECONDS=900

# ======================= SEPARATE, RARELY USED =======================
# B2 key WITH bypassGovernance. NOT in Vercel, NOT in the worker's normal env. Used only by the
# deliberate "delete backup" flow after re-authentication (later slice).
B2_BYPASS_KEY_ID=
B2_BYPASS_APPLICATION_KEY=
